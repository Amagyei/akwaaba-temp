# Copy to .env and fill in the values. .env is git-ignored, so never commit it.
# Same names go in the Claude environment's secrets setting if you want me to use them.

# --- Image generation (tools/model_shots.py) ---
# Key from Google AI Studio, on the same Google account you used for Stitch.
GEMINI_API_KEY=
# Exact Nano Banana model id from AI Studio's model list. Leave blank for the script's default.
GEMINI_IMAGE_MODEL=

# --- VPS access (only if you want me to administer it) ---
VPS_HOST=
VPS_PORT=22
# A separate non-root user, not root.
VPS_USER=
# Private key for that user, as one line with \n for line breaks, or a path if the file is on the machine running the commands.
VPS_SSH_KEY=
# Expected host key fingerprint (run: ssh-keyscan -t ed25519 your-host | ssh-keygen -lf -), so I can verify I'm on the right server.
VPS_HOST_FINGERPRINT=
